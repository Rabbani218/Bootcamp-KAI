# ============================================================================
# Environment Configuration - Traffic Anomaly Detection Backend
# ============================================================================
# Copy file ini menjadi .env dan sesuaikan value sesuai kebutuhan

# API Configuration
API_TITLE=Traffic Anomaly Detection Backend
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
MODEL_PATH=./Dataset/best_web_optimized.onnx
CONFIDENCE_THRESHOLD=0.5
TARGET_CLASSES=car,truck,motorcycle,bicycle,bus

# Temporal Anomaly Tracking Configuration
STATIONARY_THRESHOLD_MS=5000
POSITION_TOLERANCE_PIXELS=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=backend.log

# CORS Configuration
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# GPU Configuration (True/False)
USE_GPU=False

# Development/Production
ENV=development
RELOAD=true

# Performance
MAX_WORKERS=4
INFERENCE_TIMEOUT_SECONDS=30
